# 네이버 검색 API (https://developers.naver.com/apps)
NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret

# Anthropic API (https://console.anthropic.com)
ANTHROPIC_API_KEY=your_anthropic_api_key

# Discord webhook (서버설정 > 연동 > 웹후크에서 생성)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Telegram (Discord 대신 사용할 경우)
# TELEGRAM_BOT_TOKEN=your_bot_token
# TELEGRAM_CHAT_ID=your_chat_id

# Discord 봇 (무효 코드 !invalid 명령어용)
# Discord Developer Portal > Bot > Token
DISCORD_BOT_TOKEN=your_discord_bot_token
# 봇이 명령어를 들을 채널 ID (채널 우클릭 > ID 복사)
DISCORD_CHANNEL_ID=your_channel_id

# GitHub PAT (known_codes.txt 자동 커밋용)
# Settings > Developer settings > Personal access tokens > repo 체크
GH_TOKEN=your_github_pat
GH_REPO=forbid403/pte-coupon-bot
